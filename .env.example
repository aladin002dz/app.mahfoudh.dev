# Copy to .env.local for local development. In Vercel, set these under
# Project → Settings → Environment Variables, with DIFFERENT values for
# Production and Preview (see docs/guestbook.md). None of them may use a
# NEXT_PUBLIC_ prefix: they are read only by server code.

# Supabase → Project Settings → API. Use the project URL and the
# *publishable* key (sb_publishable_…), never the secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Random string used to hash visitor IPs for rate limiting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FEEDBACK_RATE_LIMIT_SECRET=

# Random string Vercel Cron sends to /api/keep-alive. Generate the same way.
CRON_SECRET=
